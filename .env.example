PORT=4000
DATABASE_URL=postgresql://football:football@localhost:5432/football_hub
REDIS_URL=redis://localhost:6379
FOOTBALL_DATA_API_KEY=your_key_here
NEXT_PUBLIC_API_URL=http://localhost:4000

ADMIN_TOKEN=change_me

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deployment settings
# Websites allowed to call the API (comma separated). Use your real website address in production.
CORS_ORIGIN=http://localhost:3000
# Set to true on the server so the API syncs fixtures and standings by itself.
ENABLE_SYNC=false

# Leagues to sync (football-data.org codes): Premier League, La Liga, Bundesliga, Serie A, Ligue 1
SYNC_COMPETITIONS=PL,PD,BL1,SA,FL1
